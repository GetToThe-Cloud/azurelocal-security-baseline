    "AZL-ACC-001": { "enabled": true },
    "AZL-ACC-002": { "enabled": true },
    "AZL-PWD-001": {
      "enabled": true,
      "parameters": { "minimumLength": 14 }
    },
    "AZL-BAN-001": {
      "enabled": true,
      "parameters": {
        "caption": "Authorised use only",
