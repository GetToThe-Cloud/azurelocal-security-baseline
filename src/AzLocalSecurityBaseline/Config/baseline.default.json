{
  "profile": "GetToTheCloud-Standard",
  "version": "1.0.0",
  "description": "Default desired state for an Azure Local system. Every control is enabled. Copy this file, keep only what you change, and pass it with -ConfigPath: values are merged over this default, so a site file of four lines is a complete configuration.",

  "controls": {
    "AZL-HW-001": { "enabled": true },
    "AZL-HW-002": { "enabled": true },

    "AZL-DRIFT-001": {
      "enabled": true,
      "parameters": { "desired": true }
    },
    "AZL-VBS-001": {
      "enabled": true,
      "parameters": { "desired": true }
    },
    "AZL-HVCI-001": {
      "enabled": true,
      "parameters": { "desired": true }
    },
    "AZL-CG-001": {
      "enabled": true,
      "parameters": { "desired": true }
    },
    "AZL-DRTM-001": {
      "enabled": true,
      "parameters": { "desired": true }
    },
    "AZL-SCM-001": {
      "enabled": true,
      "parameters": { "desired": true }
    },
    "AZL-SMB-001": {
      "enabled": true,
      "parameters": { "desired": true }
    },
    "AZL-SMB-002": {
      "enabled": true,
      "parameters": { "desired": true }
    },

    "AZL-WDAC-001": {
      "enabled": true,
      "parameters": { "desiredMode": "Enforced" }
    },
    "AZL-WDAC-002": {
      "enabled": true,
